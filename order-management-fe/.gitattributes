# Enforce LF line endings for frontend
.gitattributes text eol=lf
* text=auto
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
public/* text eol=lf
src/* text eol=lf

# Binary assets must never pass through line-ending conversion.
*.ico -text
*.jpeg -text
*.jpg -text
*.mp3 -text
*.png -text

NODE_ENV=development
LOG_LEVEL=debug
PORT=5001
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://app.rcdine.com,https://admin.rcdine.com

DB_NAME=rcdine
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

JWT_SECRET=change_this_to_a_long_random_secret
TABLE_QR_SECRET=replace_with_a_different_long_random_secret
TRIAL_DAYS=3
CRYPTO_SECRET_KEY=must_match_frontend_crypto_secret
# Server-only key for payment credentials. Never add this to the frontend environment.
SERVER_ENCRYPTION_KEY=replace_with_a_long_random_server_only_secret
PASSWORD_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

SEED_ADMIN=false
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_strong_password
ADMIN_PHONE=9999999999
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_OTP_EXPIRY_MINUTES=5
ADMIN_OTP_RESEND_COOLDOWN_SECONDS=45
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_MAX_SENDS=5
ADMIN_TOKEN_EXPIRY=4h
ADMIN_OTP_HASH_SECRET=replace_with_another_distinct_long_random_secret

# Production email (recommended for Render): Resend HTTPS API
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="R&C Dine <noreply@mail.yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com
EMAIL_TIMEOUT_MS=15000
SUPPORT_EMAIL=support@yourdomain.com

# Optional SMTP fallback for local development or paid hosting
EMAIL_USER=
EMAIL_PASS=

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=mailto:Info.rcdine@gmail.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STANDARD_MONTHLY=
STANDARD_YEARLY=

# Fast2SMS Quick SMS (without DLT)
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_TIMEOUT_MS=10000

# Customer mobile OTP security
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=15
OTP_HASH_SECRET=replace_with_a_different_long_random_secret
CUSTOMER_JWT_SECRET=replace_with_a_long_random_secret
CUSTOMER_TOKEN_EXPIRY=12h
